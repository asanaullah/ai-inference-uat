# Assisted by Claude Opus 4.6
apiVersion: v1
kind: Pod
metadata:
  name: {{ pod_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: {{ managed_by_label }}
    test: {{ test }}
    dag-step: {{ dag_step_name }}
{% if node %}
    node: {{ node }}
{% endif %}
{% if chain is defined and chain %}
    chain: {{ chain }}
{% endif %}
    sweep: {{ sweep_id }}
{% for k, v in extra_labels.items() %}
    {{ k }}: {{ v | yaml_quote }}
{% endfor %}
spec:
{% if service_account_name is defined and service_account_name %}
  serviceAccountName: {{ service_account_name }}
{% endif %}
{% if node %}
  nodeSelector:
    {{ node_selector_key }}: {{ node }}
{% endif %}
{% if privileged %}
  hostPID: true
{% endif %}
{% if sidecars is defined and sidecars %}
  initContainers:
{% for sc in sidecars %}
    - name: {{ sc.name }}
      image: {{ sc.image }}
      restartPolicy: Always
{% if sc.command %}
      command:
{% for c in sc.command %}
        - {{ c | yaml_quote }}
{% endfor %}
{% endif %}
{% if sc.args %}
      args:
{% for a in sc.args %}
        - {{ a | yaml_quote }}
{% endfor %}
{% endif %}
{% if sc.env %}
      env:
{% for e in sc.env %}
        - name: {{ e.name }}
{% if e.valueFrom is defined %}
          valueFrom:
{{ e.valueFrom | to_yaml | indent(12, first=True) }}
{% else %}
          value: {{ e.value | yaml_quote }}
{% endif %}
{% endfor %}
{% endif %}
{% if sc.ports %}
      ports:
{{ sc.ports | to_yaml | indent(8, first=True) }}
{% endif %}
{% if sc.resources %}
      resources:
{{ sc.resources | to_yaml | indent(8, first=True) }}
{% endif %}
{% if sc.volumeMounts %}
      volumeMounts:
{% for vm in sc.volumeMounts %}
        - {{ vm | to_yaml | indent(10) }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
  containers:
    - name: {{ pod_name }}
      image: {{ image }}
{% if command %}
      command:
{% for arg in command %}
        - {{ arg | yaml_quote }}
{% endfor %}
{% endif %}
{% if env %}
      env:
{% for e in env %}
        - name: {{ e.name }}
{% if e.valueFrom is defined %}
          valueFrom:
{{ e.valueFrom | to_yaml | indent(12, first=True) }}
{% else %}
          value: {{ e.value | yaml_quote }}
{% endif %}
{% endfor %}
{% endif %}
{% if ports %}
      ports:
{{ ports | to_yaml | indent(8, first=True) }}
{% endif %}
{% if resources %}
      resources:
{{ resources | to_yaml | indent(8, first=True) }}
{% endif %}
      volumeMounts:
        - name: workspace
          mountPath: /uat_workspace
          subPath: {{ workspace_subpath }}
        - name: workspace
          mountPath: /binaries
          subPath: {{ binaries_subpath }}
{% if models_storage and models_storage.pvc %}
        - name: models
          mountPath: /models
          readOnly: true
{% endif %}
{% for vm in volume_mounts %}
        - {{ vm | to_yaml | indent(10) }}
{% endfor %}
{% if privileged %}
      securityContext:
        privileged: true
{% endif %}
  volumes:
    - name: workspace
      persistentVolumeClaim:
        claimName: {{ pvc }}
{% if models_storage and models_storage.pvc %}
    - name: models
      persistentVolumeClaim:
        claimName: {{ models_storage.pvc }}
{% endif %}
{% for v in volumes %}
    - {{ v | to_yaml | indent(6) }}
{% endfor %}
  restartPolicy: Never
