# Assisted by Claude Opus
apiVersion: {{ api_version }}
kind: {{ kind }}
metadata:
  name: {{ resource_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: {{ managed_by_label }}
    test: {{ test_label }}
{% if node %}
    node: {{ node_label }}
{% endif %}
{% if chain_label is defined and chain_label %}
    chain: {{ chain_label | yaml_quote }}
{% endif %}
{% if annotations is defined and annotations %}
  annotations:
{% for k, v in annotations.items() %}
    {{ k }}: {{ v | yaml_quote }}
{% endfor %}
{% endif %}
spec:
{{ spec | to_yaml | indent(2, first=True) }}
