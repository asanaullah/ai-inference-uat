apiVersion: v1
kind: Service
metadata:
  name: {{ service_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: {{ managed_by_label }}
    test: {{ test_label }}
    dag-step: {{ dag_step_label }}
{% if node %}
    node: {{ node_label }}
{% endif %}
{% if chain_label is defined and chain_label %}
    chain: {{ chain_label | yaml_quote }}
{% endif %}
{% if sweep_label is defined %}
    sweep: {{ sweep_label | yaml_quote }}
{% endif %}
spec:
{% if headless %}
  clusterIP: None
{% endif %}
  selector:
    app.kubernetes.io/managed-by: {{ managed_by_label }}
    test: {{ test_label }}
    dag-step: {{ dag_step_label }}
{% if node %}
    node: {{ node_label }}
{% endif %}
{% if sweep_label is defined %}
    sweep: {{ sweep_label | yaml_quote }}
{% endif %}
  ports:
    - port: {{ port }}
      targetPort: {{ port }}
