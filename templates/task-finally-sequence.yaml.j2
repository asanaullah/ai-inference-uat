apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: {{ task_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: {{ managed_by_label }}
spec:
  params:
    - name: timestamp
      type: string
  steps:
{% for step in steps %}
    - name: {{ step.name }}
      image: {{ ose_cli_image }}
      script: |
{{ step.script | indent(8, first=True) }}
{% endfor %}
