apiVersion: v1
kind: Pod
metadata:
  name: {{ pod_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: {{ managed_by_label }}
    test: {{ test }}
    dag-step: {{ dag_step_name }}
{% if node %}
    node: {{ node }}
{% endif %}
{% if chain is defined and chain %}
    chain: {{ chain }}
{% endif %}
spec:
{% if node %}
  nodeSelector:
    {{ node_selector_key }}: {{ node }}
{% endif %}
{% if privileged %}
  hostPID: true
{% endif %}
  containers:
    - name: {{ pod_name }}
      image: {{ image }}
{% if command %}
      command:
{% for arg in command %}
        - {{ arg | yaml_quote }}
{% endfor %}
{% endif %}
{% if env %}
      env:
{% for e in env %}
        - name: {{ e.name }}
          value: {{ e.value | yaml_quote }}
{% endfor %}
{% endif %}
{% if ports %}
      ports:
{{ ports | to_yaml | indent(8, first=True) }}
{% endif %}
{% if readiness_probe %}
      readinessProbe:
{{ readiness_probe | to_yaml | indent(8, first=True) }}
{% endif %}
{% if resources %}
      resources:
{{ resources | to_yaml | indent(8, first=True) }}
{% endif %}
      volumeMounts:
        - name: workspace
          mountPath: /uat_workspace
          subPath: {{ workspace_subpath }}
        - name: workspace
          mountPath: /binaries
          subPath: {{ binaries_subpath }}
{% if models_storage and models_storage.pvc %}
        - name: models
          mountPath: /models
          readOnly: true
{% endif %}
{% for vm in volume_mounts %}
        - {{ vm | to_yaml | indent(10) }}
{% endfor %}
{% if privileged %}
      securityContext:
        privileged: true
{% endif %}
  volumes:
    - name: workspace
      persistentVolumeClaim:
        claimName: {{ pvc }}
{% if models_storage and models_storage.pvc %}
    - name: models
      persistentVolumeClaim:
        claimName: {{ models_storage.pvc }}
{% endif %}
{% for v in volumes %}
    - {{ v | to_yaml | indent(6) }}
{% endfor %}
  restartPolicy: Never
